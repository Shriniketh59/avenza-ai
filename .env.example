# ---------------------------------------------------------------------------
# AVENZA AI configuration. Copy to .env.local (./start.sh does this for you).
# ---------------------------------------------------------------------------

# Public base URL of the app (used for OAuth redirect URIs)
APP_URL=http://localhost:3000

# 32+ random characters; encrypts the session cookie. ./start.sh generates one.
# Manual: openssl rand -base64 48
AUTH_SECRET=

# Flask backend address (server-side only, never exposed to the browser).
# Use 127.0.0.1, not "localhost": Node may resolve localhost to IPv6 (::1) while Flask listens on IPv4.
FLASK_API_URL=http://127.0.0.1:5000

# Text generation for Avenza Flash / Avenza Plus: LLM_PROVIDER=gemini (default) or deepseek, plus its API key
# (presets in backend/avenza/config.py).
LLM_PROVIDER=gemini
LLM_API_KEY=

# Embeddings (document search) use the Gemini API: GEMINI_API_KEY is needed even with LLM_PROVIDER=deepseek.
# EMBED_MODEL=gemini-embedding-2

# Per-account usage limits in weighted tokens (Avenza Plus counts PLUS_TOKEN_WEIGHT x per token).
# USAGE_SESSION_HOURS=5
# USAGE_SESSION_TOKENS=300000
# USAGE_WEEKLY_TOKENS=2000000
# PLUS_TOKEN_WEIGHT=3

# Optional: Google sign-in (OAuth web client). Redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
