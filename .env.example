# Public base URL of this Next.js app (used for OAuth redirect URIs)
APP_URL=http://localhost:3000

# 32+ random characters. Generate: openssl rand -base64 48
AUTH_SECRET=

# Python Flask backend (server-side only, never exposed to the browser)
FLASK_API_URL=http://localhost:5000

# Google OAuth 2.0 (Web client). Authorized redirect URI:
#   ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Text generation: set ONE key (Gemini wins if both are set, or force with LLM_PROVIDER=deepseek|gemini)
# DeepSeek (paid): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_PROVIDER=
