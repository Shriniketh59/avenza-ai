# ---------------------------------------------------------------------------
# AVENZA AI configuration. Copy to .env.local (./start.sh does this for you).
# ---------------------------------------------------------------------------

# Public base URL of the app (used for OAuth redirect URIs)
APP_URL=http://localhost:3000

# 32+ random characters; encrypts the session cookie. ./start.sh generates one.
# Manual: openssl rand -base64 48
AUTH_SECRET=

# Flask backend address (server-side only, never exposed to the browser).
# Use 127.0.0.1, not "localhost": Node may resolve localhost to IPv6 (::1) while Flask listens on IPv4.
FLASK_API_URL=http://127.0.0.1:5000

# LLM API key (OpenAI-compatible chat completions endpoint). Required for text chat and agents.
# Provider presets, models and endpoints live in backend/avenza/config.py (LLM_PROVIDER selects one).
LLM_API_KEY=
LLM_PROVIDER=

# Optional: Google sign-in (OAuth web client). Redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
