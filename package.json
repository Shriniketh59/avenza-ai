{
  "name": "avenza-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"next dev\" \"npm:dev:api\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:web": "next dev",
    "dev:api": "backend/.venv/bin/python backend/run.py",
    "setup:api": "python3 -m venv backend/.venv && backend/.venv/bin/pip install -r backend/requirements.txt",
    "setup": "./start.sh --setup-only",
    "start:all": "./start.sh"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.51.0",
    "mermaid": "^11.17.2",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
